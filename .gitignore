# Build output (Cargo.lock is committed: this is an application)
/target
/target-*
**/*.rs.bk
**/mutants.out*/
rustc-ice-*.txt

# Release artifacts: app bundle, DMG, update feed, notarization output
/dist
*.dmg
*.app
*.zip
*.pkg
*.xcarchive
notarization*.json
notarize-*.log

# Generated from packaging/icon/app-icon.html by scripts/icon.sh (the .icns are committed)
/packaging/AppIcon.png
/packaging/AppIconLight.png
*.iconset

# Keys, certificates and secrets
*.key
*.pem
*.p8
*.p12
*.cer
*.mobileprovision
.env
.env.*

# Screenshots and captures from the demo stages (DISKMAN_SHOT=...)
/shots
*.png
!/crates/diskman/assets/**/*.png

# Crash reports, logs and test leftovers
*.ips
*.log
*.profraw
*.tmp

# Editors and macOS
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
